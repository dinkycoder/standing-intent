# Copy to probe/.env and fill in. NEVER commit probe/.env
# Throwaway wallet only. Testnet funds, or a few dollars of mainnet USDC.
#
# Variable names match the x402-foundation reference client example:
#   x402-reference/examples/python/clients/requests/.env-local

# EVM signing key for the buyer wallet (with or without 0x prefix).
EVM_PRIVATE_KEY=

# Solana key — NOT used by this probe (EVM only). Kept here only for name-parity
# with the reference .env-local.
# SVM_PRIVATE_KEY=

# The local seller you run yourself. There is no public x402 demo endpoint;
# every quickstart and every Python example points at localhost:4021.
RESOURCE_SERVER_URL=http://localhost:4021
ENDPOINT_PATH=/weather

# Optional: a Base RPC URL for independently confirming the settlement tx on chain.
#
# There is deliberately no facilitator URL or chain-selector variable here. In
# x402 v2 the buyer chooses neither — the seller's 402 (PAYMENT-REQUIRED header)
# declares the network and asset, and the facilitator is the seller's config.
BASE_RPC_URL=
