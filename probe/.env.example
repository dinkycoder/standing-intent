# Copy to probe/.env and fill in. NEVER commit probe/.env
# Throwaway wallet only. Testnet funds or a few dollars of mainnet USDC.

PROBE_PRIVATE_KEY=

# Read from x402 documentation. Confirm which network it serves.
X402_FACILITATOR_URL=

# CAIP-2 style chain selector. Base Sepolia = 84532, Base mainnet = 8453.
# Confirm the exact string form the installed SDK expects.
X402_CHAIN_SELECTOR=

# Base RPC endpoint for independently verifying settlement.
BASE_RPC_URL=
